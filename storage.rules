rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function awaitingBugReport(reportId, userId) {
      let report = firestore.get(/databases/(default)/documents/bug_reports/$(reportId));
      return firestore.exists(/databases/(default)/documents/bug_reports/$(reportId))
             && report.data.userId == userId
             && report.data.status == 'awaiting_upload'
             && report.data.uploadPath == 'bug-reports/' + userId + '/' + reportId + '/screenshot.jpg';
    }

    function hasActiveHealthGrant(userId, healthGrantId) {
      let userPath = /databases/(default)/documents/users/$(userId);
      let user = firestore.get(userPath);
      return firestore.exists(userPath)
             && user.data.keys().hasAll(['consents'])
             && user.data.consents is map
             && user.data.consents.keys().hasAll(['healthGranted', 'healthVersion', 'healthGrantId'])
             && user.data.consents.healthGranted == true
             && user.data.consents.healthVersion == '1.1'
             && healthGrantId.size() > 0
             && user.data.consents.healthGrantId == healthGrantId;
    }

    // Zdjęcie profilowe: dokładnie jeden prywatny plik avatars/{uid}/avatar.
    // Odczyt i zapis: wyłącznie właściciel ścieżki; obraz poniżej 5 MiB.
    match /avatars/{userId}/avatar {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && request.resource.size < 5 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Legacy zdjęć sylwetki: właściciel może odzyskać lub usunąć stare dane,
    // ale nowe zapisy trafiają wyłącznie do ścieżki wersjonowanej grantem.
    match /body-photos/{userId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Zdjęcia sylwetki v2: zapis wymaga aktywnej zgody zdrowotnej i grantu
    // zgodnego ze ścieżką. Read/delete pozostają dostępne po wycofaniu zgody.
    match /body-photos/{userId}/{healthGrantId}/{fileName} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && hasActiveHealthGrant(userId, healthGrantId)
                            && request.resource.size < 5 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');
    }

    // Zgłoszenia błędów: dokładnie jeden prywatny JPEG tworzony po createBugReport.
    // Odczyt/status/cleanup idą przez zweryfikowany backend Admin SDK; klient nie
    // może odczytać, nadpisać ani usunąć załącznika po przesłaniu.
    match /bug-reports/{userId}/{reportId}/screenshot.jpg {
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && resource == null
                   && request.resource != null
                   && request.resource.size <= 1572864
                   && request.resource.contentType == 'image/jpeg'
                   && awaitingBugReport(reportId, userId);
      allow read: if false;
    }

    // Domyślnie: brak dostępu.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
