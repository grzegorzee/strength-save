rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if user is admin
    function isAdmin() {
      return request.auth != null
             && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function userIdMatchesAuth() {
      return request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    function keepsOwner() {
      return request.resource.data.userId == resource.data.userId;
    }

    function hasSelfAccess(userId) {
      return request.auth != null
             && request.auth.uid == userId
             && exists(/databases/$(database)/documents/users/$(userId))
             // Brak pola status (konta z logowania Google / sprzed hardeningu) = traktuj jak aktywny.
             // Jawnie nieaktywni (pending_verification, suspended) nadal zablokowani.
             && (
               !('status' in get(/databases/$(database)/documents/users/$(userId)).data)
               || get(/databases/$(database)/documents/users/$(userId)).data.status == 'active'
             )
             && (
               !('access' in get(/databases/$(database)/documents/users/$(userId)).data)
               || !('enabled' in get(/databases/$(database)/documents/users/$(userId)).data.access)
               || get(/databases/$(database)/documents/users/$(userId)).data.access.enabled != false
             );
    }

    // Users collection
    match /users/{userId} {
      // Users can read their own profile
      allow read: if request.auth != null && request.auth.uid == userId;
      // Klient może zmieniać wyłącznie preferencje i dane prezentacyjne. Wszystkie
      // uprawnienia, statusy i tokeny są własnością zaufanego backendu.
      // Typy wartości (Z41): walidacja na merged dokumencie — pole obecne musi mieć
      // właściwy typ, brak pola jest OK (lekcja ef8b8d5/880cb9e).
      allow update: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      'displayName', 'photoURL', 'language', 'preferences',
                      'notificationPrefs', 'onboardingCompleted', 'onboarding',
                      'trainingProfile', 'estimatedMaxHR', 'maxHRManualOverride',
                      'prBackfill'
                    ])
                    && (!('displayName' in request.resource.data)
                        || (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 200))
                    && (!('photoURL' in request.resource.data)
                        || (request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 1000))
                    && (!('language' in request.resource.data)
                        || (request.resource.data.language is string && request.resource.data.language.size() <= 10))
                    && (!('preferences' in request.resource.data) || request.resource.data.preferences is map)
                    && (!('notificationPrefs' in request.resource.data) || request.resource.data.notificationPrefs is map)
                    && (!('onboardingCompleted' in request.resource.data) || request.resource.data.onboardingCompleted is bool)
                    && (!('onboarding' in request.resource.data) || request.resource.data.onboarding is map)
                    && (!('trainingProfile' in request.resource.data) || request.resource.data.trainingProfile is map)
                    // Max HR (Z59): zapis bezpośredni zamiast callable saveMaxHR — widełki jak w funkcji.
                    && (!('estimatedMaxHR' in request.resource.data)
                        || (request.resource.data.estimatedMaxHR is int
                            && request.resource.data.estimatedMaxHR >= 100
                            && request.resource.data.estimatedMaxHR <= 230))
                    && (!('maxHRManualOverride' in request.resource.data)
                        || request.resource.data.maxHRManualOverride is bool)
                    // Backfill rekordow (Runna p.1, spec A5): zamknieta mapa boi glownych,
                    // wartosci w kg (0-600) — twardy limit, miekkie "na pewno?" robi UI.
                    && (!('prBackfill' in request.resource.data)
                        || (request.resource.data.prBackfill is map
                            && request.resource.data.prBackfill.keys().hasOnly(['squat', 'bench', 'deadlift'])
                            && (!('squat' in request.resource.data.prBackfill)
                                || (request.resource.data.prBackfill.squat is number
                                    && request.resource.data.prBackfill.squat > 0
                                    && request.resource.data.prBackfill.squat <= 600))
                            && (!('bench' in request.resource.data.prBackfill)
                                || (request.resource.data.prBackfill.bench is number
                                    && request.resource.data.prBackfill.bench > 0
                                    && request.resource.data.prBackfill.bench <= 600))
                            && (!('deadlift' in request.resource.data.prBackfill)
                                || (request.resource.data.prBackfill.deadlift is number
                                    && request.resource.data.prBackfill.deadlift > 0
                                    && request.resource.data.prBackfill.deadlift <= 600))));
      // Admin can read/write all user profiles
      allow read, write: if request.auth != null && isAdmin();
      // Profile creation happens through Cloud Functions
      allow create: if false;

      // Z217: agregat all-time treningów (kafle Dashboardu). Pisze wyłącznie
      // backend (trigger + rebuildWorkoutAggregate przez Admin SDK) — klient
      // ma czysty odczyt własnego dokumentu.
      match /aggregates/{aggregateId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow write: if false;
      }
    }

    // Zamknięty schemat dokumentu treningu — user może zapisywać we WŁASNYCH
    // dokumentach tylko znane pola (audyt 4.3: koszty/integralność, nie cross-user).
    // Per-exercise notes są clampowane w kodzie (rules nie iterują po tablicach).
    function validWorkoutShape() {
      // createdAt: pole legacy (dokumenty sprzed schematu Z28) — bez niego update
      // takiego treningu pada PERMISSION_DENIED (hasOnly widzi CAŁY dokument po merge).
      return request.resource.data.keys().hasOnly([
        'id', 'userId', 'dayId', 'date', 'exercises', 'completed', 'completedAt',
        'notes', 'cycleId', 'skippedExercises', 'dayName', 'dayFocus',
        'durationSec', 'startedAt', 'updatedAt', 'revision', 'lastWriteId', 'createdAt',
        'importBatchId', 'sessionRating', 'sessionRatingReasons'
      ])
      && (!('notes' in request.resource.data)
          || (request.resource.data.notes is string && request.resource.data.notes.size() <= 5000))
      // Tag wsadu importu CSV (Z110) — opcjonalny string (hash pliku).
      && (!('importBatchId' in request.resource.data)
          || (request.resource.data.importBatchId is string
              && request.resource.data.importBatchId.size() <= 64))
      // Ocena sesji po treningu (Runna pakiet 1): kciuk + zamknieta lista powodow.
      && (!('sessionRating' in request.resource.data)
          || request.resource.data.sessionRating in ['up', 'down'])
      && (!('sessionRatingReasons' in request.resource.data)
          || (request.resource.data.sessionRatingReasons is list
              && request.resource.data.sessionRatingReasons.size() <= 3
              && request.resource.data.sessionRatingReasons.hasOnly(['too_heavy', 'too_long', 'weak_day'])));
    }

    // Workouts collection
    match /workouts/{workoutId} {
      // Users can only read/write their own workouts (by userId field).
      // resource == null: dokument nie istnieje — get() po ID zwraca pustkę, nic nie wycieka.
      // Bez tego getDoc na nowym (jeszcze nieutworzonym) treningu = PERMISSION_DENIED i nie da się
      // rozpocząć treningu (resource.data.userId na nieistniejącym dokumencie to błąd ewaluacji).
      allow read: if request.auth != null
                  && (isAdmin() || resource == null || hasSelfAccess(resource.data.userId));
      allow create: if userIdMatchesAuth() && hasSelfAccess(request.resource.data.userId) && validWorkoutShape();
      allow update: if request.auth != null
                    && hasSelfAccess(resource.data.userId)
                    && keepsOwner()
                    && validWorkoutShape();
      allow delete: if request.auth != null
                    && hasSelfAccess(resource.data.userId);
      // Admin can read all
      allow read: if request.auth != null && isAdmin();
    }

    // Zamknięty schemat pomiaru (Z41): znane pola liczbowe + identyfikatory.
    function validMeasurementShape() {
      return request.resource.data.keys().hasOnly([
        'id', 'userId', 'date', 'weight', 'armLeft', 'armRight', 'chest', 'waist',
        'hips', 'thighLeft', 'thighRight', 'calfLeft', 'calfRight', 'recordedAt',
        'photoUrl', 'photoPath'
      ])
      && (request.resource.data.date is string && request.resource.data.date.size() <= 10)
      && (!('recordedAt' in request.resource.data) || request.resource.data.recordedAt is number)
      // T13a: zdjęcie sylwetki — URL z tokenem + ścieżka Storage (do GDPR cleanup).
      && (!('photoUrl' in request.resource.data) || (request.resource.data.photoUrl is string && request.resource.data.photoUrl.size() <= 1000))
      && (!('photoPath' in request.resource.data) || (request.resource.data.photoPath is string && request.resource.data.photoPath.size() <= 300))
      && (!('weight' in request.resource.data) || request.resource.data.weight is number)
      && (!('armLeft' in request.resource.data) || request.resource.data.armLeft is number)
      && (!('armRight' in request.resource.data) || request.resource.data.armRight is number)
      && (!('chest' in request.resource.data) || request.resource.data.chest is number)
      && (!('waist' in request.resource.data) || request.resource.data.waist is number)
      && (!('hips' in request.resource.data) || request.resource.data.hips is number)
      && (!('thighLeft' in request.resource.data) || request.resource.data.thighLeft is number)
      && (!('thighRight' in request.resource.data) || request.resource.data.thighRight is number)
      && (!('calfLeft' in request.resource.data) || request.resource.data.calfLeft is number)
      && (!('calfRight' in request.resource.data) || request.resource.data.calfRight is number);
    }

    // Measurements collection
    match /measurements/{measurementId} {
      allow read: if request.auth != null
                  && (isAdmin() || hasSelfAccess(resource.data.userId));
      allow create: if userIdMatchesAuth() && hasSelfAccess(request.resource.data.userId) && validMeasurementShape();
      allow update: if request.auth != null
                    && hasSelfAccess(resource.data.userId)
                    && keepsOwner()
                    && validMeasurementShape();
      allow delete: if request.auth != null
                    && hasSelfAccess(resource.data.userId);
      allow read: if request.auth != null && isAdmin();
    }

    // Zamknięty schemat planu (Z41). Głęboka walidacja days (tygodnie/dni/ćwiczenia)
    // zostaje w kodzie — rules nie iterują po tablicach.
    function validTrainingPlanShape() {
      return request.resource.data.keys().hasOnly([
        'days', 'durationWeeks', 'startDate', 'updatedAt', 'revision', 'progression', 'scheduleOverrides',
        'skippedDates', 'reducedMode', 'vacation', 'status', 'name'
      ])
      // Cykl życia planu (WP-PLANS-1, X27): pole opcjonalne (stare dokumenty bez
      // pola = 'active' w sanitizerze klienta).
      && (
        !('status' in request.resource.data)
        || request.resource.data.status in ['active', 'ended']
      )
      // Nazwa planu (WP-PLANS-2, X27): opcjonalny string do 60 znakow.
      && (
        !('name' in request.resource.data)
        || (
          request.resource.data.name is string
          && request.resource.data.name.size() <= 60
        )
      )
      // Tryb urlopu (Runna p.1, spec C4): zamknieta mapa okresu + aktywnosci.
      && (
        !('vacation' in request.resource.data)
        || (
          request.resource.data.vacation is map
          && request.resource.data.vacation.keys().hasOnly(['startDate', 'endDate', 'activity', 'extendedWeeks'])
          && request.resource.data.vacation.startDate is string
          && request.resource.data.vacation.endDate is string
          && request.resource.data.vacation.activity in ['none', 'mains_only']
          && request.resource.data.vacation.extendedWeeks is number
        )
      )
      // Tryb "nie na 100%" (Runna p.1, spec C3): zamknieta mapa okresu + poziomu.
      && (
        !('reducedMode' in request.resource.data)
        || (
          request.resource.data.reducedMode is map
          && request.resource.data.reducedMode.keys().hasOnly(['startDate', 'endDate', 'level'])
          && request.resource.data.reducedMode.startDate is string
          && request.resource.data.reducedMode.endDate is string
          && request.resource.data.reducedMode.level in ['lighter', 'mains_only', 'pause']
        )
      )
      // Jawne "Pomiń trening" (Runna p.1, spec C1): lista dat YYYY-MM-DD,
      // pruning 28 dni w kodzie; limit jak overrides.
      && (
        !('skippedDates' in request.resource.data)
        || (
          request.resource.data.skippedDates is list
          && request.resource.data.skippedDates.size() <= 60
        )
      )
      // Przełożenia treningów (spec 2026-08-11): mapa data -> dayId|null, okno max
      // 42 dni (pruning 28 wstecz + horyzont 14 do przodu) => limit 60 z zapasem.
      // Klucze YYYY-MM-DD i wartości string|null waliduje kod zapisu — rules nie
      // iterują po mapach (konwencja Z41 jak przy days).
      && (
        !('scheduleOverrides' in request.resource.data)
        || (
          request.resource.data.scheduleOverrides is map
          && request.resource.data.scheduleOverrides.size() <= 60
        )
      )
      // Progresja programowa (Z119): zamknięta mapa {enabled, deloadEveryWeeks?, deloadDecisions?}.
      && (
        !('progression' in request.resource.data)
        || (
          request.resource.data.progression is map
          && request.resource.data.progression.keys().hasOnly(['enabled', 'deloadEveryWeeks', 'deloadDecisions'])
          && request.resource.data.progression.enabled is bool
          && (!('deloadEveryWeeks' in request.resource.data.progression)
              || request.resource.data.progression.deloadEveryWeeks is number)
          && (!('deloadDecisions' in request.resource.data.progression)
              || request.resource.data.progression.deloadDecisions is map)
        )
      )
      && (!('days' in request.resource.data) || request.resource.data.days is list)
      && (!('durationWeeks' in request.resource.data) || request.resource.data.durationWeeks is number)
      && (!('startDate' in request.resource.data)
          || (request.resource.data.startDate is string && request.resource.data.startDate.size() <= 10))
      && (!('updatedAt' in request.resource.data)
          || (request.resource.data.updatedAt is string && request.resource.data.updatedAt.size() <= 40))
      && (!('revision' in request.resource.data) || request.resource.data.revision is number);
    }

    // Training plans (doc ID = userId)
    match /training_plans/{planUserId} {
      // Users can read their own plan
      allow read: if request.auth != null && (isAdmin() || hasSelfAccess(planUserId));
      // Users can write their own plan
      allow write: if request.auth != null && hasSelfAccess(planUserId) && validTrainingPlanShape();
      // Admin can read/write all plans
      allow read, write: if request.auth != null && isAdmin();
    }

    // Strava activities (future)
    match /strava_activities/{activityId} {
      allow read: if request.auth != null
                  && (isAdmin() || hasSelfAccess(resource.data.userId));
      // Only Cloud Functions can write
      allow write: if false;
      allow read: if request.auth != null && isAdmin();
    }

    // Weekly summaries: klient TYLKO czyta (generator AI usunięty w Z39; functions
    // nie zapisują wcale — martwe create/update zamknięte, Z41/R2-15).
    match /weekly_summaries/{summaryId} {
      allow read: if request.auth != null
                  && (isAdmin() || hasSelfAccess(resource.data.userId));
      allow create, update: if false;
      // Admin can read/write all
      allow read, write: if request.auth != null && isAdmin();
    }

    // Chat messages: feature AI Chat usunięty w v6.7.0 — jedynym writerem jest
    // admin SDK w Functions (omija rules). Klient nie tworzy nowych wpisów.
    match /chat_messages/{messageId} {
      allow read: if request.auth != null && (isAdmin() || hasSelfAccess(resource.data.userId));
      allow create: if false;
      // Delete zamknięte spójnie z create (Z41/R2-15): GDPR kasuje przez admin SDK.
      allow delete: if false;
      allow update: if false;
      // Admin can read all
      allow read: if request.auth != null && isAdmin();
    }

    // Zamknięty schemat cyklu (Z41). Głęboka walidacja days zostaje w kodzie.
    function validPlanCycleShape() {
      return request.resource.data.keys().hasOnly([
        'userId', 'days', 'durationWeeks', 'startDate', 'endDate', 'status',
        'createdAt', 'stats', 'technical', 'hiddenFromInsights'
      ])
      && (!('days' in request.resource.data) || request.resource.data.days is list)
      && (!('durationWeeks' in request.resource.data) || request.resource.data.durationWeeks is number)
      && (!('startDate' in request.resource.data)
          || (request.resource.data.startDate is string && request.resource.data.startDate.size() <= 10))
      && (!('endDate' in request.resource.data)
          || (request.resource.data.endDate is string && request.resource.data.endDate.size() <= 10))
      && (!('status' in request.resource.data)
          || (request.resource.data.status is string && request.resource.data.status.size() <= 20))
      && (!('createdAt' in request.resource.data)
          || (request.resource.data.createdAt is string && request.resource.data.createdAt.size() <= 40))
      && (!('stats' in request.resource.data) || request.resource.data.stats is map)
      && (!('technical' in request.resource.data) || request.resource.data.technical is bool)
      && (!('hiddenFromInsights' in request.resource.data) || request.resource.data.hiddenFromInsights is bool);
    }

    // Plan cycles (training plan history)
    match /plan_cycles/{cycleId} {
      // resource == null: getCycleById po nieistniejącym ID nie wycieka danych (patrz workouts).
      allow read: if request.auth != null && (isAdmin() || resource == null || hasSelfAccess(resource.data.userId));
      allow create: if userIdMatchesAuth() && hasSelfAccess(request.resource.data.userId) && validPlanCycleShape();
      allow update: if request.auth != null
                    && hasSelfAccess(resource.data.userId)
                    && keepsOwner()
                    && validPlanCycleShape();
      allow delete: if request.auth != null && hasSelfAccess(resource.data.userId);
      allow read: if request.auth != null && isAdmin();
    }

    // Zamknięty schemat operacji merge (Z41).
    function validCycleOperationShape() {
      return request.resource.data.keys().hasOnly([
        'userId', 'kind', 'primaryCycleId', 'restCycleIds', 'workoutIds',
        'newStart', 'newEnd', 'newDuration', 'phase', 'nextWorkoutIndex', 'nextCycleIndex'
      ])
      && (!('kind' in request.resource.data)
          || (request.resource.data.kind is string && request.resource.data.kind.size() <= 30))
      && (!('primaryCycleId' in request.resource.data)
          || (request.resource.data.primaryCycleId is string && request.resource.data.primaryCycleId.size() <= 200))
      && (!('restCycleIds' in request.resource.data) || request.resource.data.restCycleIds is list)
      && (!('workoutIds' in request.resource.data) || request.resource.data.workoutIds is list)
      && (!('newStart' in request.resource.data)
          || (request.resource.data.newStart is string && request.resource.data.newStart.size() <= 10))
      && (!('newEnd' in request.resource.data)
          || (request.resource.data.newEnd is string && request.resource.data.newEnd.size() <= 10))
      && (!('newDuration' in request.resource.data) || request.resource.data.newDuration is number)
      && (!('phase' in request.resource.data)
          || (request.resource.data.phase is string && request.resource.data.phase.size() <= 30))
      && (!('nextWorkoutIndex' in request.resource.data) || request.resource.data.nextWorkoutIndex is number)
      && (!('nextCycleIndex' in request.resource.data) || request.resource.data.nextCycleIndex is number);
    }

    // Checkpoints for client-side, resumable cycle merges. They are private to the
    // owner and carry no authority beyond remapping that owner's own documents.
    match /plan_cycle_operations/{operationId} {
      allow read: if request.auth != null
                  && (isAdmin() || hasSelfAccess(resource.data.userId));
      allow create: if userIdMatchesAuth() && hasSelfAccess(request.resource.data.userId) && validCycleOperationShape();
      allow update: if request.auth != null
                    && hasSelfAccess(resource.data.userId)
                    && keepsOwner()
                    && validCycleOperationShape();
      allow delete: if request.auth != null && hasSelfAccess(resource.data.userId);
      allow read, write: if request.auth != null && isAdmin();
    }

    // Private Strava credentials — Cloud Functions only
    match /strava_connections/{userId} {
      allow read, write: if false;
    }

    // AI usage tracking (written only by Cloud Functions)
    match /ai_usage/{docId} {
      allow read: if request.auth != null && (isAdmin() || hasSelfAccess(resource.data.userId));
      allow read: if request.auth != null && isAdmin();
      allow write: if false;
    }

    // Private API keys and logs — Cloud Functions only
    match /api_keys/{keyId} {
      allow read, write: if false;
    }

    match /api_audit_logs/{logId} {
      allow read, write: if false;
    }

    match /api_rate_limits/{docId} {
      allow read, write: if false;
    }

    match /email_verification_codes/{docId} {
      allow read, write: if false;
    }

    match /invites/{inviteId} {
      allow read, write: if false;
    }

    match /waitlist_entries/{entryId} {
      allow read, write: if false;
    }

    match /auth_audit_logs/{logId} {
      allow read, write: if false;
    }

    // Log zgód (pakiet prawny v2): zapis WYŁĄCZNIE przez Cloud Function
    // recordConsent (Admin SDK omija rules) — klient nie zna swojego IP,
    // a timestamp musi być serwerowy. Odczyt tylko panel admina (eksport CSV).
    match /consents/{consentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /notification_logs/{logId} {
      allow read, write: if false;
    }

    // G-T1: rejestr wysyłek maili (pisze wyłącznie Admin SDK w callables)
    // + zdarzenia SES (pisze wyłącznie webhook sesEventsWebhook).
    // Odczyt tylko panel admina (sekcja Maile).
    match /email_log/{logId} {
      allow read: if request.auth != null && isAdmin();
      allow write: if false;

      // T21a: pełna treść maila (podgląd w panelu) — pisze tylko backend.
      match /content/{docId} {
        allow read: if request.auth != null && isAdmin();
        allow write: if false;
      }
    }

    match /email_events/{eventId} {
      allow read: if request.auth != null && isAdmin();
      allow write: if false;
    }

    // Zamknięty schemat telemetrii (Z41). Dokumenty legacy mają PŁASKIE klucze
    // "counters.xxx" (historyczny zapis dot-notation) — hasOnly musi je dopuszczać,
    // inaczej merge na takim dokumencie pada (lekcja createdAt z workouts).
    function validTelemetryShape() {
      // Zamknięta lista liczników = unia TelemetryEventName w src/lib/app-telemetry.ts.
      // X13A: walidacja przez counters.keys().hasOnly (dot-notation w top-level hasOnly
      // nigdy nie działała: stan końcowy ma tylko klucz 'counters').
      // Płaskie klucze 'counters.xxx' to TOP-LEVEL pola dokumentów legacy (historyczny
      // zapis) — merge na takim dokumencie widzi je w stanie końcowym (lekcja R2).
      return request.resource.data.keys().hasOnly([
        'userId', 'date', 'updatedAt', 'counters', 'expiresAt',
        'counters.draft_recovered', 'counters.local_save_failed', 'counters.sync_success'
      ])
      && (!('expiresAt' in request.resource.data) || request.resource.data.expiresAt is timestamp)
      && (request.resource.data.date is string && request.resource.data.date.size() <= 10)
      && (!('updatedAt' in request.resource.data)
          || (request.resource.data.updatedAt is string && request.resource.data.updatedAt.size() <= 40))
      && (!('counters' in request.resource.data)
          || (request.resource.data.counters is map
              && request.resource.data.counters.keys().hasOnly([
        'provisional_session_started', 'provisional_session_promoted',
        'draft_recovered', 'workout_auto_resume',
        'local_save_failed', 'sync_retry_manual',
        'sync_retry_batch', 'sync_retry_auto',
        'sync_success', 'sync_failure',
        'sync_validation_failed', 'final_sync_pending',
        'sync_queue_enqueued', 'revision_conflict',
        'revision_conflict_auto_resolved', 'orphan_workout',
        'mixed_plan_exercise_set',
        'session_active',
        'screen_dashboard', 'screen_plan', 'screen_analytics',
        'screen_exercises', 'screen_profile', 'screen_history',
        'screen_measurements', 'screen_achievements', 'screen_cycles',
        'screen_settings', 'screen_workout',
        'action_workout_started', 'action_workout_completed',
        'action_set_checked', 'action_plan_edited',
        'action_replan_completed', 'action_export_data',
        'action_strava_opened',
        // Z222: funnel rejestracji i monetyzacji.
        'register_started', 'profile_created', 'email_verified',
        'paywall_viewed', 'trial_started', 'purchase_failed'
              ])));
    }

    // Z222: dzienny raport kosztów chmury — pisze wyłącznie scheduled function.
    match /admin_cost_daily/{dateId} {
      allow read: if request.auth != null && isAdmin();
      allow write: if false;
    }

    match /app_telemetry_daily/{docId} {
      allow read: if request.auth != null
                  && (isAdmin() || hasSelfAccess(resource.data.userId));
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && hasSelfAccess(request.resource.data.userId)
                    && validTelemetryShape();
      allow update: if request.auth != null
                    && hasSelfAccess(resource.data.userId)
                    && keepsOwner()
                    && validTelemetryShape();
      allow delete: if false;
      allow read: if request.auth != null && isAdmin();
    }

    // Rejestr błędów produkcyjnych klienta (append-only): user tworzy własne
    // wpisy, czyta wyłącznie admin. Pełny schemat + widełki createdAt (Z41/R2-13):
    // flood nieopłacalny, klienckie createdAt nie zasłoni realnych błędów w panelu.
    // Create świadomie bez hasSelfAccess: telemetria ma działać też przy problemach
    // z profilem; koszt get() w rules > zysk. expiresAt opcjonalne: klienty
    // build <= 48 raportują bez TTL (pole doszło w Z40).
    // Z100/Z101: backupy napraw i dziennik akcji admina.
    // Backupy pisze wyłącznie Admin SDK (adminUserRepair); klient nigdy.
    match /admin_repair_backups/{backupId} {
      allow read: if request.auth != null && isAdmin();
      allow create, update, delete: if false;
    }
    // Dziennik akcji: create-only dla admina (akcje klienckie: toggles, edycje);
    // wpisów nie da się zmienić ani usunąć. Wpisy napraw dopisuje Admin SDK.
    match /admin_audit_log/{entryId} {
      allow read: if request.auth != null && isAdmin();
      allow create: if request.auth != null && isAdmin()
                    && request.resource.data.keys().hasOnly(['adminUid', 'action', 'targetUid', 'detail', 'createdAt', 'expiresAt'])
                    && request.resource.data.adminUid == request.auth.uid
                    && (request.resource.data.action is string && request.resource.data.action.size() <= 100)
                    && (request.resource.data.targetUid is string && request.resource.data.targetUid.size() <= 128)
                    && (!('detail' in request.resource.data)
                        || (request.resource.data.detail is string && request.resource.data.detail.size() <= 500))
                    && (!('expiresAt' in request.resource.data) || request.resource.data.expiresAt is timestamp);
      allow update, delete: if false;
    }

    // B-T6: inbox zdarzeń (user_events). Serwer = źródło prawdy między
    // urządzeniami. Id dokumentu = uid + '-' + klucz semantyczny (idempotencja:
    // duplikat z drugiego urządzenia/późnego syncu to update spoza readAt,
    // który jest odrzucany — oryginał zostaje). Update wyłącznie readAt.
    match /user_events/{eventId} {
      allow read: if request.auth != null
                  && (isAdmin() || (resource != null && resource.data.userId == request.auth.uid));
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && eventId == request.auth.uid + '-' + request.resource.data.key
        && request.resource.data.keys().hasOnly(['v', 'userId', 'type', 'key', 'payload', 'deepLink', 'createdAt', 'readAt'])
        && request.resource.data.v == 1
        && request.resource.data.type in ['pr', 'badge', 'week', 'plan']
        && request.resource.data.key is string
        && request.resource.data.key.size() >= 1
        && request.resource.data.key.size() <= 200
        && request.resource.data.payload is map
        && (request.resource.data.deepLink == null
            || (request.resource.data.deepLink is string && request.resource.data.deepLink.size() <= 200))
        && request.resource.data.createdAt is int
        && request.resource.data.readAt == null;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
        && request.resource.data.readAt is int;
      allow delete: if false;
    }

    match /client_errors/{errorId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly(['userId', 'code', 'phase', 'detail', 'sessionHash', 'appVersion', 'platform', 'createdAt', 'expiresAt'])
        && request.resource.data.code is string
        && request.resource.data.code.size() <= 64
        && request.resource.data.phase is string
        && request.resource.data.phase.size() <= 32
        && request.resource.data.detail is string
        && request.resource.data.detail.size() <= 500
        && (!('sessionHash' in request.resource.data)
            || (request.resource.data.sessionHash is string && request.resource.data.sessionHash.size() == 8))
        && request.resource.data.appVersion is string
        && request.resource.data.appVersion.size() <= 32
        && request.resource.data.platform in ['web', 'ios', 'android']
        && request.resource.data.createdAt is int
        && request.resource.data.createdAt >= request.time.toMillis() - 10 * 60 * 1000
        && request.resource.data.createdAt <= request.time.toMillis() + 10 * 60 * 1000
        && (!('expiresAt' in request.resource.data) || request.resource.data.expiresAt is timestamp);
      allow read: if request.auth != null && isAdmin();
      allow update, delete: if false;
    }

    // Własne ćwiczenia usera (Z71): zamknięty schemat, pełny CRUD tylko właściciel,
    // odczyt dodatkowo admin. Kategorie = 8 kluczy categoryLabels z biblioteki klienta.
    function validCustomExerciseShape() {
      return request.resource.data.keys().hasOnly([
        'userId', 'name', 'category', 'isBodyweight', 'type', 'createdAt', 'tracking'
      ])
      && request.resource.data.name is string
      && request.resource.data.name.size() >= 2
      && request.resource.data.name.size() <= 80
      && request.resource.data.category in ['chest', 'back', 'shoulders', 'legs', 'arms', 'core', 'glutes', 'calves']
      && request.resource.data.isBodyweight is bool
      && request.resource.data.type in ['compound', 'isolation']
      && request.resource.data.createdAt is int
      // Typ śledzenia serii (Z105) — opcjonalny, z zamkniętej listy.
      && (
        !('tracking' in request.resource.data)
        || request.resource.data.tracking in [
          'weight_reps', 'bodyweight_reps', 'duration',
          'weight_distance_duration', 'assisted_bodyweight'
        ]
      );
    }

    match /custom_exercises/{exerciseId} {
      allow read: if request.auth != null
                  && (isAdmin() || resource == null || hasSelfAccess(resource.data.userId));
      allow create: if userIdMatchesAuth()
                    && hasSelfAccess(request.resource.data.userId)
                    && validCustomExerciseShape();
      allow update: if request.auth != null
                    && hasSelfAccess(resource.data.userId)
                    && keepsOwner()
                    && validCustomExerciseShape();
      allow delete: if request.auth != null
                    && hasSelfAccess(resource.data.userId);
    }

    // Przypięte notatki per ćwiczenie (Z103): zamknięty schemat, doc id deterministyczny
    // `${userId}_${slug(nazwa)}`, pełny CRUD tylko właściciel, odczyt dodatkowo admin.
    function validExerciseNoteShape() {
      return request.resource.data.keys().hasOnly([
        'userId', 'exerciseName', 'note', 'machineSettings', 'updatedAt'
      ])
      && request.resource.data.userId is string
      && request.resource.data.exerciseName is string
      && request.resource.data.exerciseName.size() >= 2
      && request.resource.data.exerciseName.size() <= 120
      && request.resource.data.note is string
      && request.resource.data.note.size() <= 500
      && (
        !('machineSettings' in request.resource.data)
        || (request.resource.data.machineSettings is string
            && request.resource.data.machineSettings.size() <= 200)
      )
      && request.resource.data.updatedAt is int;
    }

    match /exercise_notes/{noteId} {
      allow read: if request.auth != null
                  && (isAdmin() || resource == null || hasSelfAccess(resource.data.userId));
      allow create: if userIdMatchesAuth()
                    && hasSelfAccess(request.resource.data.userId)
                    && validExerciseNoteShape();
      allow update: if request.auth != null
                    && hasSelfAccess(resource.data.userId)
                    && keepsOwner()
                    && validExerciseNoteShape();
      allow delete: if request.auth != null
                    && hasSelfAccess(resource.data.userId);
    }

    // Notatka przypięta do DNIA treningu (T10, feedback 2026-08-20): zamknięty
    // schemat, doc id deterministyczny `${userId}_${dateISO}`, pełny CRUD tylko
    // właściciel, odczyt dodatkowo admin.
    function validWorkoutDayNoteShape() {
      return request.resource.data.keys().hasOnly([
        'userId', 'date', 'note', 'updatedAt'
      ])
      && request.resource.data.userId is string
      && request.resource.data.date is string
      && request.resource.data.date.size() == 10
      && request.resource.data.note is string
      && request.resource.data.note.size() <= 500
      && request.resource.data.updatedAt is int;
    }

    match /workout_day_notes/{noteId} {
      allow read: if request.auth != null
                  && (isAdmin() || resource == null || hasSelfAccess(resource.data.userId));
      allow create: if userIdMatchesAuth()
                    && hasSelfAccess(request.resource.data.userId)
                    && validWorkoutDayNoteShape();
      allow update: if request.auth != null
                    && hasSelfAccess(resource.data.userId)
                    && keepsOwner()
                    && validWorkoutDayNoteShape();
      allow delete: if request.auth != null
                    && hasSelfAccess(resource.data.userId);
    }

    // Ręczne wpisy cardio (Z111): zamknięty schemat, CRUD tylko właściciel.
    // Jednostki kanoniczne: metry, sekundy. Osobna kolekcja od strava_activities (sync nadpisuje swoją).
    function validManualActivityShape() {
      return request.resource.data.keys().hasOnly([
        'userId', 'type', 'date', 'movingTime', 'name', 'distance',
        'averageHeartrate', 'calories', 'perceivedIntensity', 'description', 'createdAt'
      ])
      && request.resource.data.userId is string
      && request.resource.data.type in [
        'Run', 'Ride', 'Walk', 'Hike', 'Swim',
        'Treadmill', 'IndoorRide', 'JumpRope', 'HIIT', 'Other'
      ]
      && request.resource.data.date is string
      && request.resource.data.date.size() == 10
      && request.resource.data.movingTime is number
      && request.resource.data.movingTime > 0
      && request.resource.data.movingTime <= 86400
      && (!('name' in request.resource.data)
          || (request.resource.data.name is string && request.resource.data.name.size() <= 120))
      && (!('distance' in request.resource.data) || request.resource.data.distance is number)
      && (!('averageHeartrate' in request.resource.data) || request.resource.data.averageHeartrate is number)
      && (!('calories' in request.resource.data) || request.resource.data.calories is number)
      && (!('perceivedIntensity' in request.resource.data)
          || request.resource.data.perceivedIntensity in ['easy', 'moderate', 'hard'])
      && (!('description' in request.resource.data)
          || (request.resource.data.description is string && request.resource.data.description.size() <= 2000))
      && request.resource.data.createdAt is int;
    }

    match /manual_activities/{activityId} {
      allow read: if request.auth != null
                  && (isAdmin() || resource == null || hasSelfAccess(resource.data.userId));
      allow create: if userIdMatchesAuth()
                    && hasSelfAccess(request.resource.data.userId)
                    && validManualActivityShape();
      allow update: if request.auth != null
                    && hasSelfAccess(resource.data.userId)
                    && keepsOwner()
                    && validManualActivityShape();
      allow delete: if request.auth != null
                    && hasSelfAccess(resource.data.userId);
    }

    // Globalne flagi funkcji — każdy zalogowany czyta, tylko admin zapisuje.
    // Zawężone do feature_flags: przyszłe dokumenty configu nie wyciekają domyślnie.
    match /config/feature_flags {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    // Z125: parowanie zegarka Garmin — kody i tokeny urządzeń żyją WYŁĄCZNIE
    // po stronie Admin SDK (functions). Klient widzi swoje urządzenia przez
    // callable garminDevices, nigdy bezpośrednio (dokumenty trzymają hashe).
    match /device_pair_codes/{codeHash} {
      allow read, write: if false;
    }
    match /device_tokens/{tokenHash} {
      allow read, write: if false;
    }
    match /device_statuses/{statusId} {
      allow read, write: if false;
    }

    // chat_conversations — REMOVED (AI Chat feature removed in v6.7.0)
  }
}
