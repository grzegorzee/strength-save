<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12/AndroidX splash icon box is 288dp; keep the visible logo at 64dp. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="288dp" android:height="288dp" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item android:width="64dp" android:height="64dp" android:gravity="center">
        <bitmap android:src="@drawable/boot_logo" android:gravity="fill" />
    </item>
</layer-list>
