        "releases": [
          {
            "name": "1.0.0 (54)",
            "versionCodes": [
              "54"
            ],
            "releaseNotes": [
              {
                "language": "pl-PL",
                "text": "Poprawiono układ treningu przy większym tekście, w tym zakresy powtórzeń i pola czasu. Stabilniejsze zapisy przy słabym zasięgu. Rozgrzewka zachowuje stan po powrocie do aplikacji. Synchronizacja pokazuje rzeczywisty dzień treningu i usuwa baner po potwierdzonym zapisie.\n"
              },
              {
                "language": "en-US",
                "text": "Fixed workout layout with larger system text, including repetition ranges and time fields. Improved recovery from network errors. Warmup remains open with its progress after returning to the app. Synchronization shows the actual training day and clears the pending banner after confirmation.\n"
              }
            ],
            "status": "completed"
          }
        ]
      }
    ]
  },
